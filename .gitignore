.DS_Store
.env
config/.env
__pycache__/
*.pyc

# City configs belong to the deployment, not the framework (see the ownership
# table in docs/deployment/updating-from-upstream.md). `make use-example` and
# `make add-city` write them here; committing them upstream would make every
# deployment conflict on a file it owns. The .example.jsonc references and
# _countries.json stay tracked - the latter ships as an empty {} placeholder.
/config/cities/*.json
!/config/cities/_countries.json

# Downloaded OSM extracts and generated GTFS zips (reproducible, too large to version)
/data/.cache/*.osm.pbf
/data/.cache/*.gtfs.zip
/archive/

# Minotor routing binaries + the weekday pattern manifest that indexes them
# (regenerated with node pipeline/generate_transit_data.mjs)
/data/cities/*/*.bin
/data/cities/*/patterns.json

# Dependencies and build outputs (reproducible via npm install / npm run build)
# npm workspaces (root package.json: frontend + pipeline) hoist shared deps
# to /node_modules - services/routing stays a separate, non-workspace
# project (installed inside its own Docker image), hence its own entry.
/node_modules/
/frontend/dist/
/frontend/dev-dist/
/frontend/coverage/
/services/routing/node_modules/
/docs/.vitepress/cache/
/docs/.vitepress/dist/

# Vector tiles generated by Planetiler (reproducible via pipeline/generate_pmtiles.py)
/data/cities/*/tiles.pmtiles

# Pipeline tools downloaded at runtime (too large to version)
/pipeline/tools/

# Planetiler build artifacts (tile weights, temp files, feature DB)
/tile_weights.tsv.gz
/data/tile_weights.tsv.gz
/data/.cache/
/data/tmp/
docker-compose.override.yml
