.DS_Store
.env
config/.env
__pycache__/
*.pyc

# Downloaded OSM extracts and generated GTFS zips (reproducible, too large to version)
/data/.cache/*.osm.pbf
/data/.cache/*.gtfs.zip
/archive/

# Minotor routing binaries (regenerated with node pipeline/generate_transit_data.mjs)
/data/cities/*/*.bin

# Dependencies and build outputs (reproducible via npm install / npm run build)
# npm workspaces (root package.json: frontend + pipeline) hoist shared deps
# to /node_modules - services/routing stays a separate, non-workspace
# project (installed inside its own Docker image), hence its own entry.
/node_modules/
/frontend/dist/
/frontend/dev-dist/
/services/routing/node_modules/
/docs/.vitepress/cache/
/docs/.vitepress/dist/

# Vector tiles generated by Planetiler (reproducible via pipeline/generate_pmtiles.py)
/data/cities/*/tiles.pmtiles

# Pipeline tools downloaded at runtime (too large to version)
/pipeline/tools/

# Planetiler build artifacts (tile weights, temp files, feature DB)
/tile_weights.tsv.gz
/data/tile_weights.tsv.gz
/data/.cache/
/data/tmp/
docker-compose.override.yml
