# Copy this file to .env and fill in values for your deployment.
# VITE_* variables are inlined at build time and visible in the browser bundle —
# do not put secrets here. Server secrets belong in docker-compose .env files.

# Public domain this deployment is served from - used by deploy/nginx/
# default.conf.template (server_name, TLS cert paths, CSP) and the "web"
# service in docker-compose.yml. Needs a matching Let's Encrypt cert for
# both DOMAIN and analytics.DOMAIN already on the server before `make up`.
DOMAIN=myapp.example.com

# Optional: comma-separated slugs (must exist in config/cities.json) to ship
# only a subset of the registry in this build's city picker/auto-detect.
# Leave UNSET (commented out, not an empty string) to include every city in
# cities.json - that file alone (not this var) is what the pipeline and CI
# data-sync workflows treat as "this city exists," so an unset VITE_CITIES
# never hides a city from syncing. A set-but-wrong value filters the
# registry down to zero cities with no obvious error - see cities.ts.
# VITE_CITIES=city-slug-1,city-slug-2
# Optional: overrides cities.json's own defaultCity field for this build.
# VITE_DEFAULT_CITY=city-slug-1

# App identity
VITE_APP_NAME=MyTransitApp
# Icon used for the favicon and the in-app logo mark (frontend/public/logo/icon.svg
# by default - a generic map pin filled with VITE_THEME_COLOR below, generated by
# `make icons` - already runs once as part of `make install`). Point this at your
# own SVG/PNG for a fully custom icon, or re-run `make icons` after changing
# VITE_THEME_COLOR to regenerate the default one to match. Not committed - each
# deployment owns and commits its own generated files here.
VITE_APP_ICON=/logo/icon.svg
VITE_APP_DESCRIPTION=Public transit app for my city.
VITE_APP_URL=https://myapp.example.com
VITE_DEFAULT_LOCALE=fr
# Comma-separated locale codes matching files in src/i18n/locales/.
# Controls which languages appear in the language picker. Defaults to all available locales.
VITE_LOCALES=fr,en
# PWA manifest theme_color (Android status bar tint on launch) and the
# default favicon/logo/PWA-icon fill (`make icons` reads this - see
# VITE_APP_ICON above). Does NOT affect the app's own UI colors - those
# come from frontend/src/styles/tokens.css, overridden per-deployment via
# config/theme.css (copy config/theme.css.example to start one). The two
# usually want the same color, but are two separate settings on purpose:
# changing tokens.css's full light/dark palette from one hex isn't a
# well-defined operation, so it's not done automatically.
VITE_THEME_COLOR=#0a5c3f
# Splash/install background color used in the PWA manifest (Android home screen add).
VITE_PWA_BACKGROUND_COLOR=#ffffff

# Source repository URL — shown as a CI/Actions link in the admin panel. Leave empty to hide.
VITE_REPOSITORY_URL=https://github.com/your-org/your-repo

# Backend service URLs (relative paths work when everything runs on the same host)
VITE_ROUTING_URL=/routing/plan
VITE_POCKETBASE_URL=/pb/api

# Analytics — Umami (https://umami.is). Leave empty to disable.
VITE_ANALYTICS_URL=
VITE_ANALYTICS_WEBSITE_ID=

# Server-side secrets for the umami/umami-db docker-compose services (NOT
# VITE_* - never inlined into the browser bundle). Only every read from
# config/.env: `make up`/`make deploy` always run docker compose with
# `--env-file config/.env` (Makefile's $(COMPOSE)) - a root-level .env
# following some other guide's convention is silently never loaded.
# Generate with: openssl rand -hex 32
UMAMI_DB_PASSWORD=changeme_strong_password_here
UMAMI_APP_SECRET=changeme_random_64char_hex_here
